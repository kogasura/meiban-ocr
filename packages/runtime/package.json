{
  "name": "@meiban-ocr/runtime",
  "version": "0.4.0-internal",
  "private": true,
  "description": "Internal-only OCR runtime. Distributed by URANUS2 deployment, NOT via npm.",
  "license": "UNLICENSED",
  "author": "yuuki-okubo <yuuki1118sss@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kogasura/meiban-ocr.git",
    "directory": "packages/runtime"
  },
  "bugs": {
    "url": "https://github.com/kogasura/meiban-ocr/issues"
  },
  "keywords": [
    "ocr",
    "onnx",
    "onnxruntime-web",
    "webgpu",
    "internal"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "bundle-model": "node scripts/bundle-model.mjs",
    "prebuild": "node scripts/bundle-model.mjs",
    "build": "vite build && tsc -p tsconfig.build.json --emitDeclarationOnly",
    "build:uranus2": "node scripts/build-for-uranus2.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'lint not configured yet' && exit 0",
    "prepublishOnly": "echo 'ERROR: this package is private and must NOT be published to npm. Use pnpm build:uranus2 to package for URANUS2 deployment.' && exit 1"
  },
  "dependencies": {
    "onnxruntime-web": "^1.19.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "^2.0.0"
  }
}
